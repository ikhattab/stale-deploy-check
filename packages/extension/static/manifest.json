{
  "manifest_version": 3,
  "name": "stale-deploy-check",
  "version": "0.6.0",
  "description": "Is this tab on the old version after a deploy, and why? Checks its build, its HTML, its service worker and its files.",
  "homepage_url": "https://github.com/ikhattab/stale-deploy-check",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Is this tab on the old version?",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": ["activeTab", "scripting"]
}
